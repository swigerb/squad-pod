# Squad: union merge for append-only team state files
.squad/decisions.md merge=union
.squad/agents/*/history.md merge=union
.squad/log/** merge=union
.squad/orchestration-log/** merge=union

# Preserve source-pinned asset bytes and checksums across Windows/Linux checkouts.
webview-ui/public/assets/furniture/**/manifest.json text eol=lf
webview-ui/public/assets/pixel-agents-source.json text eol=lf
webview-ui/public/assets/**/*.png binary
