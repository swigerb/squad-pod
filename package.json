{
  "name": "squad-pod",
  "displayName": "Squad Pod",
  "description": "Pixel art office where your Squad agents come to life as animated characters",
  "version": "0.1.0",
  "publisher": "squad-pod",
  "engines": {
    "vscode": "^1.107.0",
    "node": ">=22.13.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "configuration": {
      "title": "Squad Pod",
      "properties": {
        "squad-pod.liveActivity": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Read local Copilot CLI session logs for the current workspace to show live member tools and context usage. Requires consent in Squad Pod."
        },
        "squad-pod.directorySuggestions": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Suggest recent Squad directories by reading only the working-directory field of local Copilot CLI session metadata. Suggestions never launch or save automatically."
        },
        "squad-pod.autoShowPanel": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Focus the Squad Pod panel once when the extension activates. Does not launch Squad, a terminal, or any process. Changes take effect on the next extension activation."
        }
      }
    },
    "commands": [
      {
        "command": "squad-pod.showPanel",
        "title": "Squad Pod: Show Panel"
      },
      {
        "command": "squad-pod.exportDefaultLayout",
        "title": "Squad Pod: Export Default Layout"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "squad-pod-panel",
          "title": "Squad Pod",
          "icon": "$(window)"
        }
      ]
    },
    "views": {
      "squad-pod-panel": [
        {
          "type": "webview",
          "id": "squad-pod.panelView",
          "name": "Squad Pod"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "install:all": "npm ci && npm ci --prefix webview-ui",
    "compile": "npm run check-types && node esbuild.js",
    "build": "npm run check-types && npm run build:webview && node esbuild.js --production",
    "build:webview": "npm run build --prefix webview-ui",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "vsce package --no-dependencies && node scripts/audit-pet-package.cjs",
    "check-types": "tsc --noEmit && npm run check-types --prefix webview-ui",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:webview": "npm test --prefix webview-ui",
    "test:all": "npm test && npm run test:webview",
    "verify": "npm run lint && npm run check-types && npm run test:all && npm run build && npm run test:smoke:pets-provider",
    "test:smoke:pets-provider": "node scripts/acceptance-pets.cjs",
    "serve:acceptance:pets": "node scripts/acceptance-pets.cjs --serve",
    "import-tileset": "tsx scripts/0-import-tileset.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@types/node": "^22.19.0",
    "@types/pngjs": "^6.0.5",
    "@types/vscode": "~1.107.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "npm-run-all": "^4.1.5",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12",
    "@vscode/vsce": "^4.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/swigerb/squad-pod.git"
  }
}
